# Example manifest for provision.sh. Placeholder names only; keep real
# manifests out of this repo (they name real orgs and repos).
#
#   ./provision.sh path/to/projects.manifest [--dry-run]
#
# One project per line:  <name> <org/repo> [<org/repo>...] [newproject.sh options]
# The line is exactly what you would pass to ./newproject.sh, so see
# `./newproject.sh --help` for the options.
#
# `defaults` lines are prepended to every project line; options given on a
# project line come after them, so they win. Blank lines and # comments are
# ignored. Quoting works as in a shell (the line is parsed by bash).

defaults  --pm-adapter claude

widget    example-org/widget-api example-org/widget-web   # one project, two repos
blog      example-user/blog       --no-kickoff
firmware  example-org/firmware    --pm-adapter codex --egress agent
